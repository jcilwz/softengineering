        <mxCell id="c-search" value="&lt;div style=&quot;text-align:center;&quot;&gt;&lt;b&gt;检索控制器&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#2d5a27;&quot;&gt;«control»&lt;/span&gt;&lt;/div&gt;&lt;hr style=&quot;border:none;border-top:1px solid #82b366;margin:4px 0;&quot;&gt;&lt;div style=&quot;text-align:left;font-size:11px;line-height:1.35;&quot;&gt;检索帖子(标题关键词)&lt;br&gt;返回匹配列表()&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;overflow=hidden;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="400" y="130" width="250" height="120" as="geometry"/></mxCell>
        <mxCell id="c-post" value="&lt;div style=&quot;text-align:center;&quot;&gt;&lt;b&gt;帖子控制器&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#2d5a27;&quot;&gt;«control»&lt;/span&gt;&lt;/div&gt;&lt;hr style=&quot;border:none;border-top:1px solid #82b366;margin:4px 0;&quot;&gt;&lt;div style=&quot;text-align:left;font-size:11px;line-height:1.35;&quot;&gt;查看帖子详情(帖子ID)&lt;br&gt;加载评论(帖子ID, 页码)&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;overflow=hidden;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="400" y="300" width="250" height="120" as="geometry"/></mxCell>
        <mxCell id="c-comment" value="&lt;div style=&quot;text-align:center;&quot;&gt;&lt;b&gt;评论控制器&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#2d5a27;&quot;&gt;«control»&lt;/span&gt;&lt;/div&gt;&lt;hr style=&quot;border:none;border-top:1px solid #82b366;margin:4px 0;&quot;&gt;&lt;div style=&quot;text-align:left;font-size:11px;line-height:1.35;&quot;&gt;浏览评论(帖子ID, 页码)&lt;br&gt;按时间倒序()&lt;br&gt;计算总页数()&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;overflow=hidden;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="400" y="470" width="250" height="120" as="geometry"/></mxCell>
        <mxCell id="c-reply" value="&lt;div style=&quot;text-align:center;&quot;&gt;&lt;b&gt;回复控制器&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#2d5a27;&quot;&gt;«control»&lt;/span&gt;&lt;/div&gt;&lt;hr style=&quot;border:none;border-top:1px solid #82b366;margin:4px 0;&quot;&gt;&lt;div style=&quot;text-align:left;font-size:11px;line-height:1.35;&quot;&gt;发起回复(帖子ID)&lt;br&gt;判定登录状态()&lt;br&gt;提交回复(帖子ID, 会员ID, 内容)&lt;br&gt;刷新评论列表(帖子ID)&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;overflow=hidden;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="400" y="640" width="250" height="150" as="geometry"/></mxCell>
