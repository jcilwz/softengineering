        <mxCell id="b-search" value="&lt;div style=&quot;text-align:center;&quot;&gt;&lt;b&gt;检索页面&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1f4e79;&quot;&gt;«boundary»&lt;/span&gt;&lt;/div&gt;&lt;hr style=&quot;border:none;border-top:1px solid #6c8ebf;margin:4px 0;&quot;&gt;&lt;div style=&quot;text-align:left;font-size:11px;line-height:1.35;&quot;&gt;关键词&lt;br&gt;检索结果列表&lt;/div&gt;&lt;hr style=&quot;border:none;border-top:1px solid #6c8ebf;margin:4px 0;&quot;&gt;&lt;div style=&quot;text-align:left;font-size:11px;line-height:1.35;&quot;&gt;接收检索输入()&lt;br&gt;展示匹配列表()&lt;br&gt;提示未找到()&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;overflow=hidden;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="130" width="250" height="150" as="geometry"/></mxCell>
        <mxCell id="b-detail" value="&lt;div style=&quot;text-align:center;&quot;&gt;&lt;b&gt;详情页面&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1f4e79;&quot;&gt;«boundary»&lt;/span&gt;&lt;/div&gt;&lt;hr style=&quot;border:none;border-top:1px solid #6c8ebf;margin:4px 0;&quot;&gt;&lt;div style=&quot;text-align:left;font-size:11px;line-height:1.35;&quot;&gt;帖子详情&lt;br&gt;评论页&lt;br&gt;回复输入&lt;/div&gt;&lt;hr style=&quot;border:none;border-top:1px solid #6c8ebf;margin:4px 0;&quot;&gt;&lt;div style=&quot;text-align:left;font-size:11px;line-height:1.35;&quot;&gt;展示帖子详情()&lt;br&gt;展示评论分页()&lt;br&gt;展示回复输入框()&lt;br&gt;展示提示()&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;overflow=hidden;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="330" width="250" height="180" as="geometry"/></mxCell>
