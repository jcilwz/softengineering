        <mxCell id="msg-12" value="5. 返回登录前的浏览页面&lt;br&gt;（被引导场景返回原帖）" edge="1" parent="1" style="endArrow=open;endFill=0;dashed=1;dashPattern=8 4;html=1;rounded=0;strokeColor=#333333;verticalAlign=bottom;align=center;fontSize=10;labelBackgroundColor=#ffffff;"><mxGeometry relative="1" as="geometry"><mxPoint x="325" y="1047" as="sourcePoint"/><mxPoint x="125" y="1047" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="note" value="A-4 凭证错误提示“用户名或密码错误”并回到步骤 2；登录失败次数不限制（假设 6）；注册、&lt;br&gt;找回密码不属本用例模型范围。" style="shape=note;whiteSpace=wrap;html=1;size=13;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="1125" width="820" height="54" as="geometry"/></mxCell>
