        <mxCell id="msg-0" value="1. 进入登录界面（主动进入或被引导）" edge="1" parent="1" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#333333;verticalAlign=bottom;align=center;fontSize=10;labelBackgroundColor=#ffffff;"><mxGeometry relative="1" as="geometry"><mxPoint x="125" y="215" as="sourcePoint"/><mxPoint x="325" y="215" as="targetPoint"/></mxGeometry></mxCell>
