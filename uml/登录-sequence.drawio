        <mxCell id="msglabel-10" value="4.2 建立登录态(会员)" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#111111;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="594" y="919" width="150" height="30" as="geometry"/></mxCell>
