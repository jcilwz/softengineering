        <mxCell id="b-search" value="&lt;div style=&quot;text-align:center;&quot;&gt;&lt;b&gt;检索页面&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1f4e79;&quot;&gt;«boundary»&lt;/span&gt;&lt;/div&gt;&lt;hr style=&quot;border:none;border-top:1px solid #6c8ebf;margin:4px 0;&quot;&gt;&lt;div style=&quot;text-align:left;font-size:11px;line-height:1.35;&quot;&gt;-关键词: str&lt;br&gt;-结果列表: List[帖子]&lt;/div&gt;&lt;hr style=&quot;border:none;border-top:1px solid #6c8ebf;margin:4px 0;&quot;&gt;&lt;div style=&quot;text-align:left;font-size:11px;line-height:1.35;&quot;&gt;+get() 展示检索界面&lt;br&gt;+提交检索(关键词: str)&lt;br&gt;+展示匹配列表(列表: List[帖子])&lt;br&gt;+提示未找到()&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;overflow=hidden;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="130" width="250" height="170" as="geometry"/></mxCell>
        <mxCell id="b-detail" value="&lt;div style=&quot;text-align:center;&quot;&gt;&lt;b&gt;详情页面&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1f4e79;&quot;&gt;«boundary»&lt;/span&gt;&lt;/div&gt;&lt;hr style=&quot;border:none;border-top:1px solid #6c8ebf;margin:4px 0;&quot;&gt;&lt;div style=&quot;text-align:left;font-size:11px;line-height:1.35;&quot;&gt;-帖子: Optional[帖子]&lt;br&gt;-评论页: 分页结果&lt;br&gt;-回复内容: str&lt;/div&gt;&lt;hr style=&quot;border:none;border-top:1px solid #6c8ebf;margin:4px 0;&quot;&gt;&lt;div style=&quot;text-align:left;font-size:11px;line-height:1.35;&quot;&gt;+get(帖子ID: int) 展示详情&lt;br&gt;+展示帖子详情(帖子: 帖子)&lt;br&gt;+展示评论(分页: 分页结果)&lt;br&gt;+提交回复(内容: str)&lt;br&gt;+展示回复输入框()&lt;br&gt;+展示提示(消息: str)&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;overflow=hidden;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="330" width="250" height="210" as="geometry"/></mxCell>
        <mxCell id="b-login" value="&lt;div style=&quot;text-align:center;&quot;&gt;&lt;b&gt;登录页面&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1f4e79;&quot;&gt;«boundary»&lt;/span&gt;&lt;/div&gt;&lt;hr style=&quot;border:none;border-top:1px solid #6c8ebf;margin:4px 0;&quot;&gt;&lt;div style=&quot;text-align:left;font-size:11px;line-height:1.35;&quot;&gt;-用户名: str&lt;br&gt;-密码: str&lt;/div&gt;&lt;hr style=&quot;border:none;border-top:1px solid #6c8ebf;margin:4px 0;&quot;&gt;&lt;div style=&quot;text-align:left;font-size:11px;line-height:1.35;&quot;&gt;+get() 展示登录表单&lt;br&gt;+提交凭证(用户名: str, 密码: str)&lt;br&gt;+展示错误提示(消息: str)&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;overflow=hidden;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="790" width="250" height="160" as="geometry"/></mxCell>
        <mxCell id="c-search" value="&lt;div style=&quot;text-align:center;&quot;&gt;&lt;b&gt;检索控制器&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#2d5a27;&quot;&gt;«control»&lt;/span&gt;&lt;/div&gt;&lt;hr style=&quot;border:none;border-top:1px solid #82b366;margin:4px 0;&quot;&gt;&lt;div style=&quot;text-align:left;font-size:11px;line-height:1.35;&quot;&gt;+检索帖子(关键词: str) -&gt; List[帖子]&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;overflow=hidden;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="320" y="120" width="250" height="100" as="geometry"/></mxCell>
        <mxCell id="c-post" value="&lt;div style=&quot;text-align:center;&quot;&gt;&lt;b&gt;帖子控制器&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#2d5a27;&quot;&gt;«control»&lt;/span&gt;&lt;/div&gt;&lt;hr style=&quot;border:none;border-top:1px solid #82b366;margin:4px 0;&quot;&gt;&lt;div style=&quot;text-align:left;font-size:11px;line-height:1.35;&quot;&gt;+查看帖子详情(帖子ID: int) -&gt; Optional[帖子]&lt;br&gt;+加载评论(帖子ID: int, 页码: int) -&gt; 分页结果&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;overflow=hidden;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="320" y="260" width="250" height="130" as="geometry"/></mxCell>
        <mxCell id="c-comment" value="&lt;div style=&quot;text-align:center;&quot;&gt;&lt;b&gt;评论控制器&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#2d5a27;&quot;&gt;«control»&lt;/span&gt;&lt;/div&gt;&lt;hr style=&quot;border:none;border-top:1px solid #82b366;margin:4px 0;&quot;&gt;&lt;div style=&quot;text-align:left;font-size:11px;line-height:1.35;&quot;&gt;-每页条数: int = 20&lt;/div&gt;&lt;hr style=&quot;border:none;border-top:1px solid #82b366;margin:4px 0;&quot;&gt;&lt;div style=&quot;text-align:left;font-size:11px;line-height:1.35;&quot;&gt;+浏览评论(帖子ID: int, 页码: int) -&gt; 分页结果&lt;br&gt;+计算总页数(总数: int) -&gt; int&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;overflow=hidden;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="320" y="430" width="250" height="130" as="geometry"/></mxCell>
        <mxCell id="c-reply" value="&lt;div style=&quot;text-align:center;&quot;&gt;&lt;b&gt;回复控制器&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#2d5a27;&quot;&gt;«control»&lt;/span&gt;&lt;/div&gt;&lt;hr style=&quot;border:none;border-top:1px solid #82b366;margin:4px 0;&quot;&gt;&lt;div style=&quot;text-align:left;font-size:11px;line-height:1.35;&quot;&gt;+判定登录状态() -&gt; Optional[会员]&lt;br&gt;+提交回复(帖子ID: int, 会员ID: int, 内容: str) -&gt; bool&lt;br&gt;+刷新评论列表(帖子ID: int) -&gt; 分页结果&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;overflow=hidden;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="320" y="620" width="250" height="140" as="geometry"/></mxCell>
        <mxCell id="c-auth" value="&lt;div style=&quot;text-align:center;&quot;&gt;&lt;b&gt;登录控制器&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#2d5a27;&quot;&gt;«control»&lt;/span&gt;&lt;/div&gt;&lt;hr style=&quot;border:none;border-top:1px solid #82b366;margin:4px 0;&quot;&gt;&lt;div style=&quot;text-align:left;font-size:11px;line-height:1.35;&quot;&gt;-当前会员: Optional[会员]&lt;/div&gt;&lt;hr style=&quot;border:none;border-top:1px solid #82b366;margin:4px 0;&quot;&gt;&lt;div style=&quot;text-align:left;font-size:11px;line-height:1.35;&quot;&gt;+校验凭证(用户名: str, 密码: str) -&gt; bool&lt;br&gt;+判定登录状态() -&gt; Optional[会员]&lt;br&gt;+建立登录态(会员: 会员)&lt;br&gt;+返回原页面()&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;overflow=hidden;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="320" y="800" width="250" height="160" as="geometry"/></mxCell>
        <mxCell id="d-post" value="&lt;div style=&quot;text-align:center;&quot;&gt;&lt;b&gt;帖子DAO&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5b2f7f;&quot;&gt;«DAO»&lt;/span&gt;&lt;/div&gt;&lt;hr style=&quot;border:none;border-top:1px solid #9673a6;margin:4px 0;&quot;&gt;&lt;div style=&quot;text-align:left;font-size:11px;line-height:1.35;&quot;&gt;+按标题匹配(关键词: str) -&gt; List[帖子]&lt;br&gt;+按ID查询(帖子ID: int) -&gt; Optional[帖子]&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;overflow=hidden;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="620" y="120" width="250" height="110" as="geometry"/></mxCell>
        <mxCell id="d-comment" value="&lt;div style=&quot;text-align:center;&quot;&gt;&lt;b&gt;评论DAO&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5b2f7f;&quot;&gt;«DAO»&lt;/span&gt;&lt;/div&gt;&lt;hr style=&quot;border:none;border-top:1px solid #9673a6;margin:4px 0;&quot;&gt;&lt;div style=&quot;text-align:left;font-size:11px;line-height:1.35;&quot;&gt;+分页查询(帖子ID: int, 页码: int, 每页条数: int) -&gt; 分页结果&lt;br&gt;+统计(帖子ID: int) -&gt; int&lt;br&gt;+保存(评论: 评论)&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;overflow=hidden;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="620" y="460" width="250" height="140" as="geometry"/></mxCell>
