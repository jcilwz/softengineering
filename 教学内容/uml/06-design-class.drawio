        <mxCell id="v-page" value="&lt;div style=&quot;text-align:center;&quot;&gt;&lt;b&gt;分页结果&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#333333;&quot;&gt;«值对象»&lt;/span&gt;&lt;/div&gt;&lt;hr style=&quot;border:none;border-top:1px solid #666666;margin:4px 0;&quot;&gt;&lt;div style=&quot;text-align:left;font-size:11px;line-height:1.35;&quot;&gt;-页码: int&lt;br&gt;-总页数: int&lt;br&gt;-每页条数: int&lt;br&gt;-条目: list&lt;/div&gt;&lt;hr style=&quot;border:none;border-top:1px solid #666666;margin:4px 0;&quot;&gt;&lt;div style=&quot;text-align:left;font-size:11px;line-height:1.35;&quot;&gt;+是否首页() -&gt; bool&lt;br&gt;+是否末页() -&gt; bool&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;overflow=hidden;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="620" y="650" width="250" height="160" as="geometry"/></mxCell>
        <mxCell id="e-post" value="&lt;div style=&quot;text-align:center;&quot;&gt;&lt;b&gt;帖子&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#8a5a00;&quot;&gt;«entity»&lt;/span&gt;&lt;/div&gt;&lt;hr style=&quot;border:none;border-top:1px solid #d79b00;margin:4px 0;&quot;&gt;&lt;div style=&quot;text-align:left;font-size:11px;line-height:1.35;&quot;&gt;-帖子ID: int&lt;br&gt;-标题: str&lt;br&gt;-内容: str&lt;br&gt;-发表时间: datetime&lt;br&gt;-作者: 会员&lt;/div&gt;&lt;hr style=&quot;border:none;border-top:1px solid #d79b00;margin:4px 0;&quot;&gt;&lt;div style=&quot;text-align:left;font-size:11px;line-height:1.35;&quot;&gt;+获取摘要() -&gt; str&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;overflow=hidden;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="910" y="130" width="250" height="180" as="geometry"/></mxCell>
        <mxCell id="e-comment" value="&lt;div style=&quot;text-align:center;&quot;&gt;&lt;b&gt;评论&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#8a5a00;&quot;&gt;«entity»&lt;/span&gt;&lt;/div&gt;&lt;hr style=&quot;border:none;border-top:1px solid #d79b00;margin:4px 0;&quot;&gt;&lt;div style=&quot;text-align:left;font-size:11px;line-height:1.35;&quot;&gt;-评论ID: int&lt;br&gt;-内容: str&lt;br&gt;-发表时间: datetime&lt;br&gt;-作者: 会员&lt;/div&gt;&lt;hr style=&quot;border:none;border-top:1px solid #d79b00;margin:4px 0;&quot;&gt;&lt;div style=&quot;text-align:left;font-size:11px;line-height:1.35;&quot;&gt;+获取内容() -&gt; str&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;overflow=hidden;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="910" y="460" width="250" height="160" as="geometry"/></mxCell>
        <mxCell id="e-member" value="&lt;div style=&quot;text-align:center;&quot;&gt;&lt;b&gt;会员&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#8a5a00;&quot;&gt;«entity»&lt;/span&gt;&lt;/div&gt;&lt;hr style=&quot;border:none;border-top:1px solid #d79b00;margin:4px 0;&quot;&gt;&lt;div style=&quot;text-align:left;font-size:11px;line-height:1.35;&quot;&gt;-会员ID: int&lt;br&gt;-用户名: str&lt;br&gt;-密码: str&lt;/div&gt;&lt;hr style=&quot;border:none;border-top:1px solid #d79b00;margin:4px 0;&quot;&gt;&lt;div style=&quot;text-align:left;font-size:11px;line-height:1.35;&quot;&gt;+校验密码(密码: str) -&gt; bool&lt;br&gt;+获取作者信息() -&gt; str&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;overflow=hidden;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1190" y="840" width="250" height="160" as="geometry"/></mxCell>
